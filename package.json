{
    "type": "module",
    "dependencies": {
        "cosmiconfig": "9.0.0",
        "fp-sdk": "0.5.0"
    },
    "devDependencies": {
        "prettier": "2.8.3",
        "prettier-plugin-sh": "0.12.8",
        "@types/node": "^25.2.0",
        "vitest": "^1.3.1",
        "husky": "^9.0.0"
    },
    "scripts": {
        "format": "pnpm prettier --version && pnpm prettier --quote-props=consistent --write './**/*.{yml,ts,sh}'",
        "format:check": "pnpm prettier --version && pnpm prettier --quote-props=consistent --check './**/*.{yml,ts,sh}'",
        "test": "vitest --globals=true",
        "prepare": "husky"
    }
}
